# -----------------------------------------------------------------------------
# Plantilla de variables de entorno.
# COPIAR este archivo como "server/.env" y completar los valores reales.
# server/.env NUNCA se sube a Git (esta en .gitignore): tiene secretos.
# -----------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Puerto donde escucha la API (el frontend de Vite usa el 5173)
PORT=4000

# Direccion de la base de datos.
#   - Mongo local:  mongodb://127.0.0.1:27017/ladrillera
#   - MongoDB Atlas: mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/ladrillera?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ladrillera

# Desde que direccion se permite llamar a la API (el frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Zona horaria del negocio (fechas "YYYY-MM-DD" en hora de Paraguay)
TZ_NEGOCIO=America/Asuncion

# Clave para firmar los tokens de login. Se usa recien en la Fase 2.
# Generar una larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
